# ----------------------
# Facts loader: accepts JSON list, Python list literal, or newline text
# ----------------------
def load_facts(file_path: str) -> List[str]:
    with open(file_path, "r", encoding="utf-8") as f:
        raw = f.read().strip()

    # Try JSON first
    try:
        data = json.loads(raw)
        if isinstance(data, list) and all(isinstance(x, str) for x in data):
            return [s.strip() for s in data if s.strip()]
    except Exception:
        pass

    # Try Python list literal
    try:
        data = ast.literal_eval(raw)
        if isinstance(data, list) and all(isinstance(x, str) for x in data):
            return [s.strip() for s in data if s.strip()]
    except Exception:
        pass

    # Fallback: one fact per line
    lines = [ln.strip() for ln in raw.splitlines() if ln.strip()]
    return lines

# ----------------------
# RAG: load facts to Chroma (with OpenAI embeddings so .query works)
# ----------------------
def embed_facts(file_path: str):
    documents = load_facts(file_path)

    ef = embedding_functions.OpenAIEmbeddingFunction(
        api_key=api_key,
        model_name=OPENAI_EMBED_MODEL
    )

    chroma_client = chromadb.Client()
    collection = chroma_client.get_or_create_collection(
        name="my_collection",
        embedding_function=ef
    )

    if documents:
        ids = [f"fact-{i}" for i in range(len(documents))]
        collection.upsert(documents=documents, ids=ids)
    return collection

collection = embed_facts(facts)

