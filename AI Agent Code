# Base system guidance (brand + soft compliance)
# ----------------------
COMPLIANCE_RULES = (
    "Compliance rules:\n"
    "• No medical claims, safety/efficacy assertions, or guarantees.\n"
    "• Avoid comparative/superlative claims (e.g., “best,” “safest,” “#1,” “better than X”).\n"
    "• Use clear, balanced language; encourage consulting an eye care professional.\n"
    "• Respect brand tone: clear, positive, caring; avoid jargon.\n"
)

BRAND_CONTEXT = (
    "Products: Alcon’s Clareon Toric IOL, Clareon PanOptix IOL, Precision1 Contact Lenses, TOTAL30 Contact Lenses. "
    "Audience: eye-care professionals and prospective wearers. Voice: concise, friendly, compliant."
)

def build_system_prompt(rag_snippet: Optional[str]) -> str:
    base = (
        "You are an expert in Alcon marketing and produce concrete, compliant, creative campaign assets.\n"
        f"{BRAND_CONTEXT}\n"
        f"{COMPLIANCE_RULES}\n"
        "Avoid vague advice. Be concise. If clinical or comparative claims are requested, "
        "explain you cannot make those claims and suggest compliant alternatives.\n"
    )
    if rag_snippet:
        base += f"\nRelevant context:\n{rag_snippet}\n"
    return base

# ----------------------
# RAG helper
# ----------------------
def safe_query_context(question: str) -> str:
    try:
        res = collection.query(query_texts=[question], n_results=1)
        return res.get("documents", [[]])[0][0] if res.get("documents") and res["documents"][0] else ""
    except Exception:
        return ""

# ----------------------
# Chat completion (CONVERSATIONAL: uses history)
# ----------------------
def chatgpt_response(question: str, history: List[Tuple[str, str]]) -> str:
    rag = safe_query_context(question)
    system_content = build_system_prompt(rag)

    MAX_TURNS = 6
    recent_history = history[-MAX_TURNS:] if history else []

    messages = [{"role": "system", "content": system_content}]
    for u, a in recent_history:
        if u:
            messages.append({"role": "user", "content": u})
        if a:
            messages.append({"role": "assistant", "content": a})
    messages.append({"role": "user", "content": question})

    # Simple retry
    for attempt in range(3):
        try:
            chat_completion = client.chat.completions.create(
                model=OPENAI_CHAT_MODEL,
                messages=messages,
                temperature=0.2,
                top_p=0.6,
                max_tokens=900
            )
            return chat_completion.choices[0].message.content
        except Exception as e:
            if attempt == 2:
                raise gr.Error(f"Chat request failed: {e}")

# ----------------------
# Compliance Check (post-generation) + inline highlighting
# ----------------------
RISKY_TERMS = {
    "superlatives": [r"\b(best|safest|#1|leading|unmatched|unsurpassed)\b"],
    "guarantees": [r"\b(guarantee(d)?|promise|risk[-\s]?free|zero risk|pain[-\s]?free)\b"],
    "medical_claims": [r"\b(treats?|cures?|heals?|eliminates?)\b",
                       r"\b(100%|always|will|permanent|instant(ly)?)\b"],
}
REQUIRED_DISCLOSURE = "Talk to an eye care professional to see if these lenses are right for you."

def highlight_spans(text: str, spans: List[Tuple[int, int]]) -> str:
    """Return text with <mark>…</mark> wrapped around risky spans."""
    if not spans:
        return text
    # Sort by start desc to avoid index shifts while inserting tags
    spans_sorted = sorted(spans, key=lambda s: s[0], reverse=True)
    out = text
    for start, end in spans_sorted:
        out = out[:start] + "<mark>" + out[start:end] + "</mark>" + out[end:]
    return out

def run_compliance_check(text: str, facts_snippet: str = ""):
    import re
    issues = []
    spans = []
    for rule, patterns in RISKY_TERMS.items():
        for pat in patterns:
            for m in re.finditer(pat, text, flags=re.I):
                issues.append({
                    "rule": rule,
                    "span": (m.start(), m.end()),
                    "excerpt": text[m.start():m.end()],
                    "severity": "high" if rule in ("medical_claims", "guarantees") else "medium"
                })
                spans.append((m.start(), m.end()))

    missing_disclosure = REQUIRED_DISCLOSURE.lower() not in text.lower()
    annotated_text = highlight_spans(text, spans)

    compliant_text = text
    if issues or missing_disclosure:
        sys_prompt = (
            "You are a compliance editor for regulated medical marketing. "
            "Remove clinical/superlative/guarantee claims and add balanced guidance. "
            "Keep brand voice and concision. Do not invent approvals or data. "
            f"Facts (may use tone cues, not for clinical claims): {facts_snippet}"
        )
        user_prompt = (
            "Rewrite the following copy to be compliant. "
            "Avoid superlatives, guarantees, and medical claims. "
            "Add a brief consult-a-professional line if missing.\n\n"
            f"Original:\n{text}\n\n"
            f"Ensure inclusion of: {REQUIRED_DISCLOSURE}"
        )
        try:
            edited = client.chat.completions.create(
                model=OPENAI_CHAT_MODEL,
                messages=[{"role":"system","content":sys_prompt},
                          {"role":"user","content":user_prompt}],
                temperature=0.2,
                max_tokens=500
            ).choices[0].message.content
            compliant_text = edited.strip()
        except Exception:
            if missing_disclosure:
                compliant_text = text.rstrip() + " " + REQUIRED_DISCLOSURE

    return {
        "issues": issues,
        "missing_disclosure": missing_disclosure,
        "annotated_text": annotated_text,
        "compliant_text": compliant_text
    }

# ----------------------
# Image generation (hardened)
# ----------------------
def generate_image(prompt: str, size: str = "1024x1024"):
    if not prompt or not prompt.strip():
        raise gr.Error("Please enter an image description.")

    try:
        result = client.images.generate(
            model=OPENAI_IMAGE_MODEL,
            prompt=prompt.strip(),
            size=size,
            response_format="b64_json"  # ensure base64 response
        )

        # Prefer base64 if provided
        if result.data and getattr(result.data[0], "b64_json", None):
            b64 = result.data[0].b64_json
            img_bytes = base64.b64decode(b64)
            img = Image.open(io.BytesIO(img_bytes)).convert("RGB")
            return img

        # Fallback: if a URL is returned
        if result.data and getattr(result.data[0], "url", None):
            with urllib.request.urlopen(result.data[0].url, timeout=30) as r:
                content = r.read()
            img = Image.open(io.BytesIO(content)).convert("RGB")
            return img

        # If neither b64 nor URL is present
        raise gr.Error("Image API returned no image data. Check model access and prompt content.")

    except Exception as e:
        raise gr.Error(f"Image generation failed: {e}")

# ----------------------
# UI (VisionNova / Alcon hero layout)
# ----------------------
def respond(message, chat_history, compliance_checked):
    reply = chatgpt_response(message, chat_history or [])

    if compliance_checked:
        ctx = safe_query_context(message)  # optional facts to guide rewrite tone
        check = run_compliance_check(reply, ctx)
        if check["issues"] or check["missing_disclosure"]:
            issue_summ = ", ".join(sorted(set(i["rule"] for i in check["issues"]))) if check["issues"] else "none"
            notes = f"Compliance notes: issues={len(check['issues'])} (types: {issue_summ})"
            if check["missing_disclosure"]:
                notes += " + missing disclosure"
            # Show highlighted original, then compliant rewrite
            reply = (
                f"{check['annotated_text']}\n\n---\n{notes}\n\n"
                f"Compliant rewrite:\n{check['compliant_text']}"
            )

    chat_history = (chat_history or [])
    chat_history.append((message, reply))
    return "", chat_history

